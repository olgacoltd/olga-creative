From 9d03d2401a236b1fd4c7b9ba823c358c5c9e8aa6 Mon Sep 17 00:00:00 2001
From: olgacoltd <346892864+olgacoltd@users.noreply.github.com>
Date: Fri, 23 Oct 2026 17:43:34 +0800
Subject: [PATCH 1/5] Add product branding configuration (OLGA_BRAND_*)

---
 CMakeLists.txt               |  1 +
 CMakeScripts/OlgaBrand.cmake | 17 +++++++++++++++++
 src/olga-brand.h.in          | 12 ++++++++++++
 3 files changed, 30 insertions(+)
 create mode 100644 CMakeScripts/OlgaBrand.cmake
 create mode 100644 src/olga-brand.h.in

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 073ddaf..0856e83 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -50,6 +50,7 @@ endif()
 if(INKSCAPE_VERSION_SUFFIX)
     set(INKSCAPE_VERSION ${INKSCAPE_VERSION}${INKSCAPE_VERSION_SUFFIX})
 endif()
+include(CMakeScripts/OlgaBrand.cmake) # product branding (OLGA_BRAND_*)
 
 set(CMAKE_INCLUDE_CURRENT_DIR TRUE)
 
diff --git a/CMakeScripts/OlgaBrand.cmake b/CMakeScripts/OlgaBrand.cmake
new file mode 100644
index 0000000..0408a99
--- /dev/null
+++ b/CMakeScripts/OlgaBrand.cmake
@@ -0,0 +1,17 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Product branding for a rebranded build (based on Inkscape).
+# The build script passes these from brand.json; the defaults keep a plain build working.
+
+set(OLGA_BRAND_NAME       "OlgaDraw" CACHE STRING "Product display name (UTF-8)")
+set(OLGA_BRAND_NAME_ASCII "OlgaDraw" CACHE STRING "Product name for Windows resources / installer (ASCII)")
+set(OLGA_BRAND_ID         "olgadraw" CACHE STRING "Lower-case ASCII id: executable name and profile directory")
+set(OLGA_APP_ID           "tw.olga.OlgaDraw" CACHE STRING "Application id (reverse DNS)")
+set(OLGA_BRAND_VENDOR     "Olga" CACHE STRING "Vendor / company name (ASCII)")
+set(OLGA_BRAND_URL        "https://inkscape.org" CACHE STRING "Product homepage")
+set(OLGA_BRAND_VERSION_SUFFIX "" CACHE STRING "Appended to the Inkscape version, e.g. -olga1")
+set(OLGA_BRAND_SUMMARY    "Vector graphics editor based on Inkscape" CACHE STRING "One-line description (ASCII)")
+
+set(OLGA_BRAND_VERSION "${INKSCAPE_VERSION}${OLGA_BRAND_VERSION_SUFFIX}")
+
+configure_file(${CMAKE_SOURCE_DIR}/src/olga-brand.h.in ${CMAKE_BINARY_DIR}/include/olga-brand.h)
+message("Brand: ${OLGA_BRAND_NAME} ${OLGA_BRAND_VERSION} (${OLGA_BRAND_ID}, ${OLGA_APP_ID})")
diff --git a/src/olga-brand.h.in b/src/olga-brand.h.in
new file mode 100644
index 0000000..b64917a
--- /dev/null
+++ b/src/olga-brand.h.in
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Generated by CMake from src/olga-brand.h.in (see CMakeScripts/OlgaBrand.cmake). Do not edit.
+#ifndef OLGA_BRAND_H
+#define OLGA_BRAND_H
+
+#define OLGA_BRAND_NAME    "@OLGA_BRAND_NAME@"
+#define OLGA_BRAND_ID      "@OLGA_BRAND_ID@"
+#define OLGA_APP_ID        "@OLGA_APP_ID@"
+#define OLGA_BRAND_VERSION "@OLGA_BRAND_VERSION@"
+#define OLGA_UPSTREAM_NAME "Inkscape"
+
+#endif // OLGA_BRAND_H
