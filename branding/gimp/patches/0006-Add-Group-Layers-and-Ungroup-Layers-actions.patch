+/* The selected layers in stacking order (top first), leaving out a layer
+ * whose ancestor group is selected too (it moves along with that group).
+ */
+static GList *
+layers_get_selected_top_level_sorted (GimpImage *image)
+{
+  GList *selected = gimp_image_get_selected_layers (image);
+  GList *all      = gimp_image_get_layer_list (image);
+  GList *result   = NULL;
+  GList *iter;
+
+  for (iter = all; iter; iter = iter->next)
+    {
+      GimpItem *item = iter->data;
+      GimpItem *parent;
+      gboolean  skip = FALSE;
+
+      if (! g_list_find (selected, item))
+        continue;
+
+      for (parent = gimp_item_get_parent (item);
+           parent;
+           parent = gimp_item_get_parent (parent))
+        {
+          if (g_list_find (selected, parent))
+            {
+              skip = TRUE;
+              break;
+            }
+        }
+
+      if (! skip)
+        result = g_list_prepend (result, item);
+    }
+
+  g_list_free (all);
+
+  return g_list_reverse (result);
+}
+
+void
+layers_group_selected_cmd_callback (GimpAction *action,
+                                    GVariant   *value,
+                                    gpointer    data)
+{
+  GimpImage *image;
+  GList     *layers;
+  GList     *iter;
+  GimpLayer *group;
+  GimpItem  *parent;
+  gint       position;
+  gint       index = 0;
+  return_if_no_image (image, data);
+
+  if (gimp_image_get_floating_selection (image))
+    return;
+
+  layers = layers_get_selected_top_level_sorted (image);
+
+  if (! layers)
+    return;
+
+  /* the new group takes the place of the topmost selected layer */
+  parent   = gimp_item_get_parent (layers->data);
+  position = gimp_item_get_index (layers->data);
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_LAYER_ADD,
+                               _("Group Layers"));
+
+  group = gimp_group_layer_new (image);
+  gimp_image_add_layer (image, group, GIMP_LAYER (parent), position, TRUE);
+
+  for (iter = layers; iter; iter = iter->next)
+    gimp_image_reorder_item (image, iter->data, GIMP_ITEM (group), index++,
+                             TRUE, NULL);
+
+  g_list_free (layers);
+
+  {
+    GList *new_selected = g_list_prepend (NULL, group);
+
+    gimp_image_set_selected_layers (image, new_selected);
+    g_list_free (new_selected);
+  }
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+}
+
+void
+layers_ungroup_cmd_callback (GimpAction *action,
+                             GVariant   *value,
+                             gpointer    data)
+{
+  GimpImage *image;
+  GList     *layers;
+  GList     *groups       = NULL;
+  GList     *new_selected = NULL;
+  GList     *iter;
+  return_if_no_image (image, data);
+
+  if (gimp_image_get_floating_selection (image))
+    return;
+
+  layers = layers_get_selected_top_level_sorted (image);
+
+  for (iter = layers; iter; iter = iter->next)
+    if (gimp_viewable_get_children (GIMP_VIEWABLE (iter->data)))
+      groups = g_list_prepend (groups, iter->data);
+
+  g_list_free (layers);
+
+  if (! groups)
+    return;
+
+  gimp_image_undo_group_start (image, GIMP_UNDO_GROUP_IMAGE_ITEM_REMOVE,
+                               _("Ungroup Layers"));
+
+  for (iter = groups; iter; iter = iter->next)
+    {
+      GimpItem      *group    = iter->data;
+      GimpItem      *parent   = gimp_item_get_parent (group);
+      GimpContainer *children = gimp_viewable_get_children (GIMP_VIEWABLE (group));
+      GList         *kids;
+      GList         *kid;
+      gint           position = gimp_item_get_index (group);
+
+      /* the group's direct children, top first; moving each one above the
+       * group keeps their order and their place in the stack
+       */
+      kids = g_list_copy (gimp_item_stack_get_item_iter (GIMP_ITEM_STACK (children)));
+
+      for (kid = kids; kid; kid = kid->next)
+        {
+          gimp_image_reorder_item (image, kid->data, parent, position++,
+                                   TRUE, NULL);
+          new_selected = g_list_prepend (new_selected, kid->data);
+        }
+
+      g_list_free (kids);
+
+      gimp_image_remove_layer (image, GIMP_LAYER (group), TRUE, NULL);
+    }
+
+  g_list_free (groups);
+
+  gimp_image_set_selected_layers (image, new_selected);
+  g_list_free (new_selected);
+
+  gimp_image_undo_group_end (image);
+  gimp_image_flush (image);
+}
+
 void
 layers_select_cmd_callback (GimpAction *action,
                             GVariant   *value,
