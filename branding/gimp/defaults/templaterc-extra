# Product templates (olga-creative): common sizes for online shops, social posts and Taiwanese print
# formats, listed before GIMP's own templates (which are all kept). Web sizes at 72 ppi like most
# web-first editors; print sizes at 300 ppi.

(GimpTemplate "電商商品圖 1000×1000"
    (icon-name "gimp-web")
    (width 1000)
    (height 1000)
    (unit pixels)
    (xresolution 72)
    (yresolution 72)
    (resolution-unit inches)
    (image-type rgb)
    (fill-type white))
